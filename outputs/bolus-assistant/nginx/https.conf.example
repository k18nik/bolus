# Use with your trusted certificate and a private deployment domain.
# Set ENVIRONMENT=production, SECURE_COOKIES=true, ALLOWED_ORIGIN=https://your-domain.
server {
    listen 443 ssl;
    server_name diary.example.com;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    client_max_body_size 21m;
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $backend_server backend:8000;
    set $frontend_server frontend:3000;
    access_log off;
    location /api/ { proxy_pass http://$backend_server; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; }
    location / { proxy_pass http://$frontend_server; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; }
}
server { listen 80; server_name diary.example.com; return 301 https://$host$request_uri; }
