# Copy to .env. Use a long random URL-safe value (letters/digits/-/_) for this password.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
DEMO_ENABLED=false
# Research prototype. Keep false until independent clinical validation.
CLINICAL_USE_ENABLED=false
FEATURE_AI=true
OPENAI_MODEL=gpt-4.1-mini
# Set a persistent Fernet key for encrypting personal API credentials.
APP_ENCRYPTION_KEY=
FEATURE_PERSONALIZATION=false
FEATURE_CYCLE=true
FEATURE_BARCODE=false
FEATURE_CGM=false
# Public food search; no YAZIO login or API key is required.
YAZIO_ENABLED=true
YAZIO_COUNTRY=RU
YAZIO_LOCALE=ru_RU
# Required legacy search parameter, not a medical-profile attribute.
YAZIO_SEARCH_SEX=male
USDA_API_KEY=
